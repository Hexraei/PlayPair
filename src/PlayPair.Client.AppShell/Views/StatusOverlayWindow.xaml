<Window x:Class="PlayPair.Client.AppShell.Views.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PlayPair Status"
        Width="420"
        Height="430"
        MinWidth="380"
        MinHeight="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="PlayPair status overlay">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Room Session" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="_Room Code:" Target="{Binding ElementName=JoinRoomCodeTextBox}" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="8,4,0,4"
                           Text="{Binding CurrentRoomCode, TargetNullValue=Not connected}"
                           AutomationProperties.Name="Current room code value" />

                <Label Grid.Row="1" Grid.Column="0" Content="_Connection:" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="8,4,0,4"
                           Text="{Binding ConnectedStatusText}"
                           AutomationProperties.Name="Current connection status value" />

                <Label Grid.Row="2" Grid.Column="0" Content="_Media:" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="8,4,0,4"
                           Text="{Binding MediaDetectionStatusText}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Media detection placeholder value" />

                <Label Grid.Row="3" Grid.Column="0" Content="_Sync:" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Margin="8,4,0,4"
                           Text="{Binding SyncStateText}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Sync state placeholder value" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Create / Join Room" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Margin="0,0,0,8"
                        Command="{Binding CreateRoomCommand}"
                        Content="_Create Room"
                        AutomationProperties.Name="Create room action"
                        TabIndex="0" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="_Join Code:" Target="{Binding ElementName=JoinRoomCodeTextBox}" VerticalAlignment="Center" />
                    <TextBox x:Name="JoinRoomCodeTextBox"
                             Width="140"
                             Margin="8,0,8,0"
                             MaxLength="6"
                             CharacterCasing="Upper"
                             Text="{Binding JoinRoomCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Room code input for joining a room"
                             TabIndex="1" />
                    <Button Command="{Binding JoinRoomCommand}"
                            Content="_Join Room"
                            AutomationProperties.Name="Join room action"
                            TabIndex="2" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CopyRoomCodeCommand}"
                            Content="C_opy Room Code"
                            AutomationProperties.Name="Copy active room code action"
                            TabIndex="3" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding ReconnectCommand}"
                            Content="_Reconnect"
                            AutomationProperties.Name="Reconnect action"
                            TabIndex="4" />
                    <Button Command="{Binding LeaveRoomCommand}"
                            Content="_Leave Room"
                            AutomationProperties.Name="Leave room action"
                            TabIndex="5" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2"
                Background="#FFFDE9E9"
                BorderBrush="#FFB63C3C"
                BorderThickness="1"
                Padding="10"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FF8A1616"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Error message region" />
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Text="PlayPair MVP shell"
                       Foreground="#FF666666"
                       AutomationProperties.Name="Footer product text" />
            <Button DockPanel.Dock="Right"
                    Width="84"
                    Command="{Binding ExitCommand}"
                    Content="E_xit"
                    AutomationProperties.Name="Exit application action"
                    TabIndex="6" />
        </DockPanel>
    </Grid>
</Window>
