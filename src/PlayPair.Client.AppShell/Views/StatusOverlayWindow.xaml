<Window x:Class="PlayPair.Client.AppShell.Views.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PlayPair Hub"
        Width="380"
        Height="500"
        MinWidth="350"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#0D0E11"
        Foreground="#ECEEF2"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        AutomationProperties.Name="PlayPair status overlay">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Modern Minimalist Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1D1F26" />
            <Setter Property="Foreground" Value="#ECEEF2" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderBrush" Value="#22242B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252831" />
                    <Setter Property="BorderBrush" Value="#2C2F3A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#111215" />
                    <Setter Property="Foreground" Value="#575758" />
                    <Setter Property="BorderBrush" Value="#18191E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#15161A" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D1F26" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2A1B1B" />
            <Setter Property="BorderBrush" Value="#4A2222" />
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D2424" />
                    <Setter Property="BorderBrush" Value="#5D2B2B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15161A" />
            <Setter Property="Foreground" Value="#ECEEF2" />
            <Setter Property="CaretBrush" Value="#ECEEF2" />
            <Setter Property="BorderBrush" Value="#22242B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Area -->
            <RowDefinition Height="Auto" /> <!-- Actions / Join -->
            <RowDefinition Height="Auto" /> <!-- Error Display -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PlayPair" FontSize="18" FontWeight="Bold" Foreground="#ECEEF2" />
                <Border Background="#202229" 
                        BorderBrush="#2C2F3A" 
                        BorderThickness="1" 
                        CornerRadius="2" 
                        Padding="6,2" 
                        Margin="8,0,0,0" 
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentRole}" 
                               FontWeight="SemiBold" 
                               FontSize="10" 
                               Foreground="#A9B2C3" />
                </Border>
            </StackPanel>
            <TextBlock Text="Watch in Sync" FontSize="11" Foreground="#7E8494" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical">
                
                <!-- Room Info Card -->
                <Border Background="#15161A" BorderBrush="#22242B" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Room Code -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ROOM CODE" FontSize="9" FontWeight="Bold" Foreground="#7E8494" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentRoomCode, TargetNullValue=Not connected}" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="#5294E2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Current room code value" />
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding CopyRoomCodeCommand}" 
                                    Content="Copy" 
                                    Height="20" 
                                    Padding="6,1"
                                    FontSize="10"
                                    AutomationProperties.Name="Copy active room code action" />
                        </StackPanel>

                        <!-- Connection Status -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CONNECTION" FontSize="9" FontWeight="Bold" Foreground="#7E8494" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding ConnectedStatusText}" 
                                   FontWeight="SemiBold" 
                                   Foreground="#10B981" 
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Current connection status value" />

                        <!-- Sync Status -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SYNC STATUS" FontSize="9" FontWeight="Bold" Foreground="#7E8494" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                   Text="{Binding SyncStateText}" 
                                   Foreground="#ECEEF2" 
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Sync state placeholder value" />
                    </Grid>
                </Border>

                <!-- Media Widget Card -->
                <Border Background="#15161A" BorderBrush="#22242B" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="NOW PLAYING" FontSize="9" FontWeight="Bold" Foreground="#7E8494" Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Media Accent Icon -->
                            <Border Grid.Column="0" Background="#22242B" Width="32" Height="32" CornerRadius="2" Margin="0,0,10,0">
                                <TextBlock Text="▶" Foreground="#5294E2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            </Border>

                            <!-- Media Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle, TargetNullValue=No Media Detected}" 
                                           FontWeight="Bold" 
                                           FontSize="13" 
                                           Foreground="#ECEEF2" />
                                <TextBlock Text="{Binding MediaApp, TargetNullValue=Idle}" 
                                           FontSize="11" 
                                           Foreground="#7E8494" 
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#22242B" Margin="0,10,0,10" />

                        <!-- Playback State -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Playback State" FontSize="11" Foreground="#7E8494" />
                            <TextBlock DockPanel.Dock="Right" 
                                       Text="{Binding PlaybackStateText, TargetNullValue=Unknown}" 
                                       FontWeight="SemiBold" 
                                       Foreground="#5294E2"
                                       AutomationProperties.Name="Media detection placeholder value" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Room Participants Card -->
                <Border Background="#15161A" BorderBrush="#22242B" BorderThickness="1" CornerRadius="2" Padding="12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="PEOPLE IN ROOM" FontSize="9" FontWeight="Bold" Foreground="#7E8494" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RoomParticipantsStatus}" 
                                   FontSize="11" 
                                   Foreground="#ECEEF2" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions / Joining Section -->
        <Border Grid.Row="2" Background="#15161A" BorderBrush="#22242B" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                
                <!-- Main Actions -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Margin="0,0,4,0" 
                            Command="{Binding CreateRoomCommand}" 
                            Content="Create Room"
                            AutomationProperties.Name="Create room action" />
                    
                    <Button Grid.Column="1" 
                            Style="{StaticResource DangerButton}" 
                            Margin="4,0,0,0" 
                            Command="{Binding LeaveRoomCommand}" 
                            Content="Leave Room"
                            AutomationProperties.Name="Leave room action" />
                </Grid>

                <Border Height="1" Background="#22242B" Margin="0,0,0,10" />

                <!-- Join Section -->
                <DockPanel>
                    <Label Content="Join Code:" Foreground="#7E8494" VerticalAlignment="Center" Margin="0,0,6,0" Padding="0" Target="{Binding ElementName=JoinRoomCodeTextBox}"/>
                    <Button DockPanel.Dock="Right" 
                            Command="{Binding JoinRoomCommand}" 
                            Content="Join" 
                            Width="60"
                            AutomationProperties.Name="Join room action" />
                    <TextBox x:Name="JoinRoomCodeTextBox" 
                             Margin="0,0,6,0"
                             MaxLength="6"
                             CharacterCasing="Upper"
                             Text="{Binding JoinRoomCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Room code input for joining a room" />
                </DockPanel>

                <!-- Reconnect -->
                <Button Margin="0,6,0,0" 
                        Style="{StaticResource SecondaryButton}" 
                        Command="{Binding ReconnectCommand}" 
                        Content="Reconnect to Server"
                        AutomationProperties.Name="Reconnect action" />
            </StackPanel>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="3"
                Background="#2A1B1B"
                BorderBrush="#4A2222"
                BorderThickness="1"
                CornerRadius="2"
                Padding="8"
                Margin="0,0,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Padding="0,0,16,0"
                           AutomationProperties.Name="Error message region" />
                
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearErrorCommand}"
                        Content="×"
                        Width="18"
                        Height="18"
                        Padding="0"
                        FontSize="11"
                        FontWeight="Bold"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Dismiss error log action" />
            </Grid>
        </Border>

        <!-- Transient Notification Banner -->
        <Border Grid.Row="3"
                Background="#1C1D24"
                BorderBrush="#2B2D38"
                BorderThickness="1"
                CornerRadius="2"
                Padding="8"
                Margin="0,0,0,10"
                Visibility="{Binding HasTransientMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ℹ " Foreground="#5294E2" FontWeight="Bold" />
                <TextBlock Text="{Binding TransientMessage}"
                           Foreground="#ECEEF2"
                           FontWeight="Medium"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Text="PlayPair Dashboard"
                       Foreground="#575758"
                       FontSize="10"
                       AutomationProperties.Name="Footer product text" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Width="70"
                    Height="24"
                    Command="{Binding ExitCommand}"
                    Content="Exit"
                    AutomationProperties.Name="Exit application action" />
        </DockPanel>
    </Grid>
</Window>
