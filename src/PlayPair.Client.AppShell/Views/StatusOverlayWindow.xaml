<Window x:Class="PlayPair.Client.AppShell.Views.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PlayPair Hub"
        Width="320"
        Height="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#111113"
        BorderBrush="#27272A"
        BorderThickness="1"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="DM Sans, Century Gothic, Segoe UI"
        MouseDown="Window_MouseDown"
        AutomationProperties.Name="PlayPair status overlay">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Premium Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="FontFamily" Value="DM Sans, Century Gothic, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272A" />
                    <Setter Property="BorderBrush" Value="#3F3F46" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#141416" />
                    <Setter Property="Foreground" Value="#3F3F46" />
                    <Setter Property="BorderBrush" Value="#1E1E22" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger/Leave Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D1A1A" />
            <Setter Property="BorderBrush" Value="#4C1F1F" />
            <Setter Property="Foreground" Value="#F87171" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C1F1F" />
                    <Setter Property="BorderBrush" Value="#7F1D1D" />
                    <Setter Property="Foreground" Value="#FEF2F2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Accent/Join Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#5B6CF9" />
            <Setter Property="BorderBrush" Value="#5B6CF9" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4655D6" />
                    <Setter Property="BorderBrush" Value="#4655D6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reconnect/Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#71717A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="DM Mono, Cascadia Code, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Error/Notification Area (Stackable) -->
            <RowDefinition Height="*" />    <!-- Content Area (Scrollable if needed, but fixed layout) -->
            <RowDefinition Height="Auto" /> <!-- Actions Section -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PlayPair" FontSize="14" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                
                <!-- Role Indicator Badge -->
                <Border Margin="8,0,0,0"
                        Background="#1E1E22"
                        BorderBrush="#27272A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentRole}"
                               FontWeight="SemiBold"
                               FontSize="9"
                               Foreground="#71717A" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Connection Dot -->
                <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#71717A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#3ED97A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Fill" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectedStatusText}" FontSize="12" Foreground="#71717A" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Error & Notification Stack -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,12">
            <!-- Error Banner -->
            <Border Background="#2D1A1A"
                    BorderBrush="#4C1F1F"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#F87171"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Padding="0,0,12,0" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Command="{Binding ClearErrorCommand}"
                            Content="×"
                            FontSize="14"
                            FontWeight="Bold"
                            Width="16" Height="16"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Transient Toast Messages -->
            <Border Background="#1C1D24"
                    BorderBrush="#2B2D38"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasTransientMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ " Foreground="#7C8FFF" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding TransientMessage}"
                               Foreground="#ECEEF2"
                               FontSize="11.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Content Area -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <!-- Room Code Card -->
            <Border Background="#141416"
                    BorderBrush="#27272A"
                    BorderThickness="0.5"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="ROOM CODE" FontSize="9.5" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CurrentRoomCode, TargetNullValue=------}"
                                   FontFamily="DM Mono, Cascadia Code, Consolas"
                                   FontSize="24"
                                   FontWeight="Medium"
                                   Foreground="#7C8FFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding CopyRoomCodeCommand}"
                            Content="📋"
                            FontSize="14"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="Copy Code" />
                </Grid>
            </Border>

            <!-- Now Playing Card -->
            <Border Background="#141416"
                    BorderBrush="#27272A"
                    BorderThickness="0.5"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="NOW PLAYING" FontSize="9.5" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E1E22" BorderBrush="#27272A" BorderThickness="0.5" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0">
                            <TextBlock Text="▶" Foreground="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle, TargetNullValue=No Media Detected}"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            
                            <!-- Process name (visible to local player only in their UI dashboard) -->
                            <TextBlock Text="{Binding MediaApp, TargetNullValue=Idle}"
                                       FontSize="11.5"
                                       Foreground="#71717A"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- People in Room Card -->
            <Border Background="#141416"
                    BorderBrush="#27272A"
                    BorderThickness="0.5"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="PEOPLE IN ROOM" FontSize="9.5" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,6" />
                    
                    <ScrollViewer MaxHeight="45" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding RoomParticipantsStatus}"
                                   FontSize="12"
                                   Foreground="#A1A1AA"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Actions / Joining Section -->
        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,12,0,8">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                        Margin="0,0,4,0"
                        Command="{Binding CreateRoomCommand}"
                        Content="New Room" />
                
                <Button Grid.Column="1"
                        Style="{StaticResource DangerButton}"
                        Margin="4,0,0,0"
                        Command="{Binding LeaveRoomCommand}"
                        Content="Leave" />
            </Grid>

            <!-- Join Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0"
                         x:Name="JoinRoomCodeTextBox"
                         Margin="0,0,6,0"
                         MaxLength="6"
                         CharacterCasing="Upper"
                         Text="{Binding JoinRoomCodeInput, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,6"
                         Height="34"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Room code input" />
                
                <Button Grid.Column="1"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding JoinRoomCommand}"
                        Content="Join"
                        Width="70" />
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <!-- Reconnect Refresh Button -->
            <Button Style="{StaticResource IconButton}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding ReconnectCommand}"
                    Content="↻"
                    FontSize="16"
                    Width="24" Height="20"
                    ToolTip="Reconnect to Server" />
            
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource IconButton}"
                    Click="CloseButton_Click"
                    Content="Close"
                    FontSize="11"
                    Foreground="#71717A"
                    Width="45" Height="20"
                    ToolTip="Close to System Tray" />
        </Grid>
    </Grid>
</Window>
